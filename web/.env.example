# Public origin for Stripe success/cancel URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Checkout + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator panel (/operator) — default fallback in code: rada-pilot
OPERATOR_PASSWORD=

# Resend transactional email (optional — skipped when empty)
RESEND_API_KEY=
RESEND_FROM=Rada Pism <onboarding@resend.dev>

# Vercel Blob — when set, files + submission JSON use Blob; else local uploads/ + data/
BLOB_READ_WRITE_TOKEN=

# Privacy-first analytics (optional cookieless Plausible — no Meta/GA)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# Optional: append analytics events to data/analytics.ndjson in production
# ANALYTICS_FILE_LOG=1
