# Skopiuj do .env.production.local (lokalny build prod) albo wklej w Vercel → Environment Variables.
# NIE commituj prawdziwych wartości.

NEXT_PUBLIC_APP_URL=https://TWOJA-DOMENA.vercel.app

# Wymagane na produkcji (trwały storage)
BLOB_READ_WRITE_TOKEN=

# Płatności
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail
RESEND_API_KEY=
RESEND_FROM=Rada Pism <noreply@twoja-domena.pl>

# Panel /operator — ustaw silne hasło
OPERATOR_PASSWORD=

# Opcjonalnie — privacy analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
